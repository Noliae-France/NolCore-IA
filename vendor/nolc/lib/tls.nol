// TLS terminant pour Nolc, en pur Nolc par-dessus OpenSSL (FFI).
//
// nolc build serveur.nol --lien ssl --lien crypto \
// --chemin-lib $(brew --prefix openssl@3)/lib
//
// Modèle : un contexte (chargé avec certificat + clé), puis pour chaque
// socket TCP accepté on enveloppe la connexion en TLS. OpenSSL 3 s'initialise
// tout seul. Les handles OpenSSL sont des Ptr<T> opaques, jamais des Int :
// ABI correcte et pas de confusion avec le descripteur de socket.

opaque TlsMethod
opaque TlsCtx
opaque TlsSession

extern fn TLS_server_method() -> Ptr<TlsMethod>
extern fn SSL_CTX_new(method: Ptr<TlsMethod>) -> Ptr<TlsCtx>
extern fn SSL_CTX_use_certificate_file(ctx: Ptr<TlsCtx>, fichier: Text, typ: Int) -> Int
extern fn SSL_CTX_use_PrivateKey_file(ctx: Ptr<TlsCtx>, fichier: Text, typ: Int) -> Int
extern fn SSL_CTX_free(ctx: Ptr<TlsCtx>)
extern fn SSL_new(ctx: Ptr<TlsCtx>) -> Ptr<TlsSession>
extern fn SSL_set_fd(ssl: Ptr<TlsSession>, fd: Int) -> Int
extern fn SSL_accept(ssl: Ptr<TlsSession>) -> Int
extern fn SSL_read(ssl: Ptr<TlsSession>, buf: bytes_len Bytes, num: Int) -> Int
extern fn SSL_write(ssl: Ptr<TlsSession>, buf: Text, num: Int) -> Int
extern fn SSL_shutdown(ssl: Ptr<TlsSession>) -> Int
extern fn SSL_free(ssl: Ptr<TlsSession>)

// --- côté CLIENT (validation stricte) ---
// Les prototypes émis restent « cosmétiques » (comme pour libsodium/serveur) :
// les handles sont des Ptr<T> opaques, les long C reçoivent des Int. SSL_ctrl /
// SSL_CTX_ctrl portent les macros OpenSSL (SNI, version minimale) via leurs
// constantes numériques, car ces macros ne sont pas des symboles liables.
extern fn TLS_client_method() -> Ptr<TlsMethod>
extern fn SSL_connect(ssl: Ptr<TlsSession>) -> Int
extern fn SSL_CTX_set_verify(ctx: Ptr<TlsCtx>, mode: Int, rappel: Ptr)
extern fn SSL_CTX_set_default_verify_paths(ctx: Ptr<TlsCtx>) -> Int
extern fn SSL_CTX_load_verify_locations(ctx: Ptr<TlsCtx>, cafile: Text, capath: Ptr) -> Int
extern fn SSL_CTX_ctrl(ctx: Ptr<TlsCtx>, cmd: Int, larg: Int, parg: Ptr) -> Int
extern fn SSL_get_verify_result(ssl: Ptr<TlsSession>) -> Int
extern fn SSL_set1_host(ssl: Ptr<TlsSession>, nom: Text) -> Int
extern fn SSL_ctrl(ssl: Ptr<TlsSession>, cmd: Int, larg: Int, parg: Text) -> Int

// SSL_FILETYPE_PEM = 1
// SSL_VERIFY_PEER = 1
// X509_V_OK = 0
// TLS1_2_VERSION = 0x0303 = 771
// SSL_CTRL_SET_MIN_PROTO_VERSION = 123 (SSL_CTX_ctrl)
// SSL_CTRL_SET_TLSEXT_HOSTNAME = 55, TLSEXT_NAMETYPE_host_name = 0 (SSL_ctrl, SNI)

// Crée un contexte serveur à partir d'un certificat et d'une clé (PEM).
fn tls_contexte(certificat: Text, cle: Text) -> Option<Ptr<TlsCtx>> {
    unsafe {
        let ctx = SSL_CTX_new(TLS_server_method())
        if ptr_est_nul(ctx) {
            return none
        }
        if SSL_CTX_use_certificate_file(ctx, certificat, 1) != 1 {
            SSL_CTX_free(ctx)
            return none
        }
        if SSL_CTX_use_PrivateKey_file(ctx, cle, 1) != 1 {
            SSL_CTX_free(ctx)
            return none
        }
        return some(ctx)
    }
}

// Enveloppe un socket TCP accepté en session TLS (handshake serveur).
fn tls_accepter(ctx: Ptr<TlsCtx>, fd: Int) -> Option<Ptr<TlsSession>> {
    unsafe {
        let ssl = SSL_new(ctx)
        if ptr_est_nul(ssl) {
            return none
        }
        let _f = SSL_set_fd(ssl, fd)
        if SSL_accept(ssl) != 1 {
            SSL_free(ssl)
            return none
        }
        return some(ssl)
    }
}

// Lit des données déchiffrées ("" si fin ou erreur).
fn tls_lire(ssl: Ptr<TlsSession>) -> Text {
    unsafe {
        var tampon = bytes_zeros(16384)
        let n = SSL_read(ssl, tampon, len(tampon))
        if n <= 0 {
            return ""
        }
        return unwrap_or(bytes_to_text(bytes_slice(tampon, 0, n)), "")
    }
}

// Écrit des données (chiffrées sur le fil). Retourne le nombre d'octets.
fn tls_ecrire(ssl: Ptr<TlsSession>, donnees: Text) -> Int {
    unsafe {
        return SSL_write(ssl, donnees, len(donnees))
    }
}

fn tls_fermer(ssl: Ptr<TlsSession>) {
    unsafe {
        let _s = SSL_shutdown(ssl)
        SSL_free(ssl)
    }
}

fn tls_liberer_contexte(ctx: Ptr<TlsCtx>) {
    unsafe {
        SSL_CTX_free(ctx)
    }
}

// ------------------- Côté CLIENT -------------------
//
// Contexte client SÛR PAR DÉFAUT : TLS 1.2 minimum, chaîne de confiance = CA
// système (SSL_CTX_set_default_verify_paths), et vérification EXIGÉE du
// certificat pair (SSL_VERIFY_PEER : le handshake échoue si la chaîne ou
// l'expiration ne valident pas). La vérification du NOM D'HÔTE se fait par
// session (tls_connecter), pas au niveau du contexte.

// Crée un contexte client validant. none si OpenSSL refuse (méthode, CA système).
fn tls_client_contexte() -> Option<Ptr<TlsCtx>> {
    unsafe {
        let ctx = SSL_CTX_new(TLS_client_method())
        if ptr_est_nul(ctx) {
            return none
        }
        // TLS 1.2 minimum (refuse SSLv3/TLS1.0/1.1).
        let _v = SSL_CTX_ctrl(ctx, 123, 771, ptr_null())
        // Chaîne de confiance = magasin de CA du système.
        if SSL_CTX_set_default_verify_paths(ctx) != 1 {
            SSL_CTX_free(ctx)
            return none
        }
        // Exige et vérifie le certificat du pair (échec du handshake sinon).
        SSL_CTX_set_verify(ctx, 1, ptr_null())
        return some(ctx)
    }
}

// Variante : contexte client dont la chaîne de confiance est un FICHIER de CA
// précis (bundle PEM), au lieu du magasin système. Utile pour épingler une CA
// privée (mTLS interne, CA d'entreprise) ou une CA racine dédiée. La validation
// reste tout aussi stricte (SSL_VERIFY_PEER + nom d'hôte au moment du connect).
// none si OpenSSL refuse la méthode ou le fichier de CA.
fn tls_client_contexte_ca(fichier_ca: Text) -> Option<Ptr<TlsCtx>> {
    unsafe {
        let ctx = SSL_CTX_new(TLS_client_method())
        if ptr_est_nul(ctx) {
            return none
        }
        let _v = SSL_CTX_ctrl(ctx, 123, 771, ptr_null())
        if SSL_CTX_load_verify_locations(ctx, fichier_ca, ptr_null()) != 1 {
            SSL_CTX_free(ctx)
            return none
        }
        SSL_CTX_set_verify(ctx, 1, ptr_null())
        return some(ctx)
    }
}

// Enveloppe un socket TCP DÉJÀ connecté en session TLS cliente vers `hote`,
// avec validation stricte : SNI, vérification du nom d'hôte (SAN/CN) et contrôle
// du résultat de vérification de la chaîne. none (connexion refusée) si l'une de
// ces étapes échoue : JAMAIS de connexion en aveugle.
fn tls_connecter(ctx: Ptr<TlsCtx>, fd: Int, hote: Text) -> Option<Ptr<TlsSession>> {
    unsafe {
        let ssl = SSL_new(ctx)
        if ptr_est_nul(ssl) {
            return none
        }
        let _f = SSL_set_fd(ssl, fd)
        // Vérification du nom d'hôte : SANS ELLE, un certificat valide pour un
        // AUTRE domaine (MITM) serait accepté. OpenSSL contrôle alors SAN/CN.
        if SSL_set1_host(ssl, hote) != 1 {
            SSL_free(ssl)
            return none
        }
        // SNI (Server Name Indication) : nécessaire au serveur pour présenter le
        // bon certificat sur un hôte virtuel mutualisé.
        let _s = SSL_ctrl(ssl, 55, 0, hote)
        if SSL_connect(ssl) != 1 {
            SSL_free(ssl)
            return none
        }
        // Défense en profondeur : X509_V_OK == 0. SSL_VERIFY_PEER a déjà dû
        // échouer avant ici en cas de problème, mais on revérifie explicitement.
        if SSL_get_verify_result(ssl) != 0 {
            let _sd = SSL_shutdown(ssl)
            SSL_free(ssl)
            return none
        }
        return some(ssl)
    }
}

// Lit un bloc déchiffré depuis une session TLS. "" si fin de flux ou erreur.
// (Identique à tls_lire, exposé sous un nom orienté client pour la lisibilité.)
fn tls_client_lire(ssl: Ptr<TlsSession>) -> Text {
    return tls_lire(ssl)
}
